{%- liquid
  assign layout = block.settings.layout | default: 'split'
  if layout == 'full_bleed'
    assign layout_class = 'pbs-hero--full-bleed'
    assign image_sizes = '100vw'
  else
    assign layout_class = 'pbs-hero--split'
    assign image_sizes = '(min-width: 769px) 50vw, 100vw'
  endif

  assign align = block.settings.content_position | default: 'start'
  assign cta_width = block.settings.cta_width | default: 'full'
  assign content_position_mobile = block.settings.content_position_mobile | default: 'end'
  assign heading_text = block.settings.heading
  assign image_alt = heading_text
  if block.settings.hero_image.alt != blank
    assign image_alt = block.settings.hero_image.alt
  elsif block.settings.hero_image_mobile.alt != blank
    assign image_alt = block.settings.hero_image_mobile.alt
  endif
  assign overlay_alpha = block.settings.overlay_opacity | times: 0.01
  assign overlay_color = block.settings.color_overlay | color_modify: 'alpha', overlay_alpha
  assign cta_hover = block.settings.color_cta_bg | color_darken: 15

  assign show_cta = false
  if block.settings.cta_link != blank and block.settings.cta_text != blank
    assign show_cta = true
  endif

  assign show_cards = false
  for i in (1..4)
    assign link_key = 'card_' | append: i | append: '_link'
    assign title_key = 'card_' | append: i | append: '_title'
    if block.settings[link_key] != blank or block.settings[title_key] != blank
      assign show_cards = true
    endif
  endfor

  assign schema_description = block.settings.tagline | default: page_description | default: shop.brand.short_description

  if block.settings.hero_image
    assign hero_image_url = block.settings.hero_image | image_url: width: 2000
  elsif block.settings.hero_image_mobile
    assign hero_image_url = block.settings.hero_image_mobile | image_url: width: 1200
  endif
  if shop.brand.logo
    assign brand_logo_url = shop.brand.logo | image_url: width: 500
  endif

  unless section.index > 1
    assign hero_loading = 'eager'
    assign hero_fetchpriority = 'high'
    assign hero_preload = true
  else
    assign hero_loading = 'lazy'
    assign hero_fetchpriority = 'auto'
    assign hero_preload = false
  endunless
-%}

<div
  class="pbs-hero {{ layout_class }} pbs-hero--align-{{ align }} pbs-hero--cta-{{ cta_width }} pbs-hero--mobile-align-{{ content_position_mobile }}"
  style="
    --pbs-hero-bg: {{ block.settings.color_background }};
    --pbs-hero-heading: {{ block.settings.color_heading }};
    --pbs-hero-text: {{ block.settings.color_text }};
    --pbs-hero-cta-bg: {{ block.settings.color_cta_bg }};
    --pbs-hero-cta-text: {{ block.settings.color_cta_text }};
    --pbs-hero-cta-hover: {{ cta_hover }};
    --pbs-hero-overlay: {{ overlay_color }};
    --pbs-hero-radius: {{ block.settings.media_radius }}px;
    --pbs-hero-media-ratio: {{ block.settings.media_ratio }};
  "
>
  {%- capture pbs_hero_media -%}
    <div
      class="pbs-hero__media"
      {% if layout == 'split' %}
        style="aspect-ratio: var(--pbs-hero-media-ratio);"
      {% endif %}
    >
      {%- if block.settings.hero_image != blank and block.settings.hero_image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 768px)"
            srcset="
              {{ block.settings.hero_image_mobile | image_url: width: 400 }} 400w,
              {{ block.settings.hero_image_mobile | image_url: width: 600 }} 600w,
              {{ block.settings.hero_image_mobile | image_url: width: 800 }} 800w,
              {{ block.settings.hero_image_mobile | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
            width="{{ block.settings.hero_image_mobile.width }}"
            height="{{ block.settings.hero_image_mobile.height }}"
          >
          <source
            media="(min-width: 769px)"
            srcset="
              {{ block.settings.hero_image | image_url: width: 600 }} 600w,
              {{ block.settings.hero_image | image_url: width: 900 }} 900w,
              {{ block.settings.hero_image | image_url: width: 1200 }} 1200w,
              {{ block.settings.hero_image | image_url: width: 1600 }} 1600w,
              {{ block.settings.hero_image | image_url: width: 2000 }} 2000w
            "
            sizes="{{ image_sizes }}"
            width="{{ block.settings.hero_image.width }}"
            height="{{ block.settings.hero_image.height }}"
          >
          {{
            block.settings.hero_image
            | image_url: width: 2000
            | image_tag:
              class: 'pbs-hero__image',
              widths: '600, 900, 1200, 1600, 2000',
              sizes: image_sizes,
              loading: hero_loading,
              fetchpriority: hero_fetchpriority,
              alt: image_alt
          }}
        </picture>
      {%- elsif block.settings.hero_image != blank and hero_preload -%}
        {{
          block.settings.hero_image
          | image_url: width: 2000
          | image_tag:
            class: 'pbs-hero__image',
            widths: '600, 900, 1200, 1600, 2000',
            sizes: image_sizes,
            loading: hero_loading,
            fetchpriority: hero_fetchpriority,
            preload: true,
            alt: image_alt
        }}
      {%- elsif block.settings.hero_image != blank -%}
        {{
          block.settings.hero_image
          | image_url: width: 2000
          | image_tag:
            class: 'pbs-hero__image',
            widths: '600, 900, 1200, 1600, 2000',
            sizes: image_sizes,
            loading: hero_loading,
            fetchpriority: hero_fetchpriority,
            alt: image_alt
        }}
      {%- elsif block.settings.hero_image_mobile != blank and hero_preload -%}
        {{
          block.settings.hero_image_mobile
          | image_url: width: 1200
          | image_tag:
            class: 'pbs-hero__image',
            widths: '400, 600, 800, 1200',
            sizes: image_sizes,
            loading: hero_loading,
            fetchpriority: hero_fetchpriority,
            preload: true,
            alt: image_alt
        }}
      {%- elsif block.settings.hero_image_mobile != blank -%}
        {{
          block.settings.hero_image_mobile
          | image_url: width: 1200
          | image_tag:
            class: 'pbs-hero__image',
            widths: '400, 600, 800, 1200',
            sizes: image_sizes,
            loading: hero_loading,
            fetchpriority: hero_fetchpriority,
            alt: image_alt
        }}
      {%- else -%}
        <div class="pbs-hero__placeholder">
          <span>{{ 'pbs_hero.placeholder.image' | t }}</span>
        </div>
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {%- capture pbs_hero_cards -%}
    {%- if show_cards -%}
      <div class="pbs-hero__cards">
        {%- for i in (1..4) -%}
          {% render 'pbs-hero-card', settings: block.settings, index: i, fallback_alt: heading_text %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endcapture -%}

  {%- if layout == 'full_bleed' -%}
    {{ pbs_hero_media }}
  {%- endif -%}

  {%- if layout == 'full_bleed' -%}
    <style>
      @media (max-width: 768px) {
        .pbs-hero--full-bleed .pbs-hero__content {
          min-height: 100svh;
        }
      }
    </style>
  {%- endif -%}

  <div class="pbs-hero__container">
    <div class="pbs-hero__content">
      {%- if heading_text != blank -%}
        <h1 class="pbs-hero__heading">{{ heading_text | escape }}</h1>
      {%- endif -%}

      {%- if block.settings.tagline != blank -%}
        <p class="pbs-hero__tagline">{{ block.settings.tagline | escape }}</p>
      {%- endif -%}

      {%- if show_cta -%}
        <a href="{{ block.settings.cta_link }}" class="pbs-hero__cta">
          {{ block.settings.cta_text | escape }}
        </a>
      {%- endif -%}

      {%- unless layout == 'full_bleed' -%}
        {{ pbs_hero_cards }}
      {%- endunless -%}
    </div>

    {%- unless layout == 'full_bleed' -%}
      {{ pbs_hero_media }}
    {%- endunless -%}

    {%- if layout == 'full_bleed' -%}
      {{ pbs_hero_cards }}
    {%- endif -%}
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ page_title | default: shop.name | json }},
    "description": {{ schema_description | json }},
    "url": {{ canonical_url | json }}
    {%- if hero_image_url -%}
      ,"image": {{ hero_image_url | json }}
    {%- endif -%}
    ,"about": {
      "@type": "Thing",
      "name": {{ shop.name | json }},
      "description": {{ schema_description | json }}
    },
    "mainEntity": {
      "@type": "WebPageElement",
      "name": {{ block.settings.heading | json }},
      "description": {{ block.settings.tagline | json }}
      {%- if hero_image_url -%}
        ,"image": {{ hero_image_url | json }}
      {%- endif -%}
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'pbs_hero.breadcrumb.home' | t | json }},
          "item": {{ shop.url | json }}
        }
      ]
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
      {%- if brand_logo_url -%}
        ,"logo": {{ brand_logo_url | json }}
      {%- endif -%}
    }
    {%- if show_cta -%}
      ,"potentialAction": [
        {
          "@type": "ViewAction",
          "name": {{ block.settings.cta_text | json }},
          "target": {{ block.settings.cta_link | json }}
        }
      ]
    {%- endif -%}
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "description": {{ schema_description | json }}
    {%- if brand_logo_url -%}
      ,"logo": {{ brand_logo_url | json }}
    {%- endif -%}
    ,"brand": {
      "@type": "Brand",
      "name": {{ shop.name | json }}
    }
  }
</script>

  {%- if template.name == 'collection' and collection -%}
    {%- if collection.image -%}
      {%- assign collection_image_url = collection.image | image_url: width: 1200 -%}
    {%- endif -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": {{ collection.title | json }},
        "description": {{ collection.description | json }},
        "url": {{ shop.url | append: collection.url | json }}
        {%- if collection_image_url -%}
          ,"image": {{ collection_image_url | json }}
        {%- endif -%}
        ,"hasPart": {
          "@type": "ItemList",
          "itemListElement": [
            {%- for product in collection.products limit: 10 -%}
              {
                "@type": "ListItem",
                "position": {{ forloop.index }},
                "url": {{ shop.url | append: product.url | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      }
    </script>
  {%- endif -%}

