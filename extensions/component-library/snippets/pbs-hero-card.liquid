{% doc %}
  Renders a single hero card from block settings for the given index.

  @param {object} settings - Block settings containing card_* values
  @param {number} index - Card slot number (1–4)
  @param {string} [fallback_alt] - Alt text used when the card has no title
  @example
  {% render 'pbs-hero-card', settings: block.settings, index: 1, fallback_alt: heading_text %}
{% enddoc %}

{%- liquid
  assign link_key = 'card_' | append: index | append: '_link'
  assign title_key = 'card_' | append: index | append: '_title'
  assign subtitle_key = 'card_' | append: index | append: '_subtitle'
  assign image_key = 'card_' | append: index | append: '_image'

  assign card_url = settings[link_key]
  assign card_title = settings[title_key]
  assign card_subtitle = settings[subtitle_key]
  assign card_image = settings[image_key]
  assign card_overlay_alpha = settings.card_overlay_opacity | times: 0.01
  assign card_overlay = settings.card_overlay | color_modify: 'alpha', card_overlay_alpha
  assign card_alt = card_title | default: fallback_alt

  if index == 1
    assign card_fallback = 'pbs-hero-card-shop.png'
  elsif index == 2
    assign card_fallback = 'pbs-hero-card-routine.png'
  elsif index == 3
    assign card_fallback = 'pbs-hero-card-journal.png'
  else
    assign card_fallback = 'pbs-hero-card-profile.png'
  endif
-%}

{%- if card_title != blank or card_url != blank -%}
  {%- if card_url != blank -%}
    <a
      href="{{ card_url }}"
      class="pbs-hero__card"
      style="
        --pbs-card-bg: {{ settings.card_bg_color }};
        --pbs-card-overlay: {{ card_overlay }};
        --pbs-card-text: {{ settings.card_text_color }};
        --pbs-card-radius: {{ settings.card_radius }}px;
      "
    >
  {%- else -%}
    <div
      class="pbs-hero__card"
      style="
        --pbs-card-bg: {{ settings.card_bg_color }};
        --pbs-card-overlay: {{ card_overlay }};
        --pbs-card-text: {{ settings.card_text_color }};
        --pbs-card-radius: {{ settings.card_radius }}px;
      "
    >
  {%- endif -%}
    <div class="pbs-hero__card-media">
      {%- if card_image != blank -%}
        {{
          card_image
          | image_url: width: 900
          | image_tag:
            class: 'pbs-hero__card-image',
            widths: '400, 600, 900',
            sizes: '(min-width: 1024px) 25vw, (min-width: 769px) 50vw, 100vw',
            loading: 'lazy',
            alt: card_alt
        }}
      {%- else -%}
        <img
          src="{{ card_fallback | asset_url }}"
          class="pbs-hero__card-image"
          alt="{{ card_alt | escape }}"
          width="900"
          height="1200"
          loading="lazy"
        >
      {%- endif -%}
    </div>
    <span class="pbs-hero__card-overlay"></span>
    <span class="pbs-hero__card-body">
      {%- if card_title != blank -%}
        <span class="pbs-hero__card-title">{{ card_title | escape }}</span>
      {%- endif -%}
      {%- if card_subtitle != blank -%}
        <span class="pbs-hero__card-subtitle">{{ card_subtitle | escape }}</span>
      {%- endif -%}
    </span>
    {%- if card_url != blank -%}
      <span class="pbs-hero__card-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false">
          <circle cx="12" cy="12" r="10.25"></circle>
          <path d="M10 8.5 14.5 12 10 15.5"></path>
        </svg>
      </span>
    {%- endif -%}
  {%- if card_url != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
{%- endif -%}
